# Set these in the process environment; mail-reply does not load .env files.
# JSON configuration path, used when --config is omitted; relative to the working directory.
MAIL_REPLY_CONFIG=<config-file>
# Optional comma-separated addresses or @domains overriding the config allow list.
MAIL_REPLY_ALLOW=<allowed-address-or-domain>
# Optional state-file path overriding the config; relative to the working directory.
MAIL_REPLY_STATE=<state-file>
# IMAP password-file path override; relative to the working directory, never a password value.
MAIL_REPLY_PASSWORD_FILE=<password-file>
# Composio key-file path override; relative to the working directory, never a key value.
MAIL_REPLY_COMPOSIO_KEY_FILE=<key-file>
